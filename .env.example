# Environment variables this repository reads. None is required and none is a secret.
# The research system (nse/) needs no credentials, API keys or broker tokens, and must
# never be given any (D10, D17). Do not create a .env with secrets; .env is git-ignored.

# Set to 1 to make missing local evidence FAIL instead of SKIP (run_all --acceptance sets it).
# NSE_PHASE1_ACCEPTANCE=1

# Owner-only override read by .claude/hooks/guard.py to allow git staging/commit/push for
# one session after an explicit owner authorisation. Leave unset; agents must never set it.
# NSE_ALLOW_GIT_WRITE=1

# Set by Claude Code for hooks; do not set by hand.
# CLAUDE_PROJECT_DIR=/path/to/day-trader-skill

# Legacy US skill pack only (trader-news, trader-analyst): SEC EDGAR asks for an identity.
# SEC_USER_AGENT="Your Name you@example.com"
