if barstate.isconfirmed and (is_strong_bull or is_strong_bear)
    last_strong_index := bar_index
    last_strong_dir := is_strong_bull ? "bull" : "bear"

f_cluster_can_continue() =>
    inside_wick = high <= cluster_wick_high and low >= cluster_wick_low
    is_transition = inside_wick and body_ratio <= i_base_threshold * 1.5
    breaks_out = close > cluster_wick_high or close < cluster_wick_low
    (is_base and not breaks_out) or is_transition

