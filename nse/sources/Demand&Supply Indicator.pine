border_style = i_border_style == "Dashed" ? line.style_dashed : i_border_style == "Dotted" ? line.style_dotted : line.style_solid
zone_line_style = i_zone_line_style == "Dashed" ? line.style_dashed : i_zone_line_style == "Dotted" ? line.style_dotted : line.style_solid
text_size = i_text_size == "Small" ? size.small : i_text_size == "Normal" ? size.normal : i_text_size == "Large" ? size.large : i_text_size == "Huge" ? size.huge : size.tiny
weekly_line_style = i_weekly_line_style == "Dashed" ? line.style_dashed : i_weekly_line_style == "Dotted" ? line.style_dotted : line.style_solid
monthly_line_style = i_monthly_line_style == "Dashed" ? line.style_dashed : i_monthly_line_style == "Dotted" ? line.style_dotted : line.style_solid

// ══════════════════════════════════════════════════════════════════════════════
// TREND ENGINE - HTF EMA LINE MANAGEMENT
// ══════════════════════════════════════════════════════════════════════════════

f_get_line_style(string style_str) =>
    switch style_str
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_dotted

f_get_label_size(string size_str) =>
    switch size_str
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        => size.small

f_calc_core_score(int test_count, int legout_count, bool has_gap, int base_count) =>
    float freshness = test_count == 0 ? 3.0 : test_count == 1 ? 1.5 : 0.0
    float strength = 0.0
    if legout_count >= 2 or (legout_count >= 1 and has_gap)
        strength := 2.0
    else if legout_count >= 1
        strength := 1.0
    float time_score = base_count <= 3 ? 2.0 : base_count <= 5 ? 1.0 : 0.0
    freshness + strength + time_score

htf_line_style_val = f_get_line_style(i_htf_line_style)
htf_label_size_val = f_get_label_size(i_htf_label_size)

var line htf_line_weekly = na
var line htf_line_monthly = na
var line htf_line_quarterly = na
var line htf_line_halfyear = na
var line htf_line_yearly = na

var label htf_label_weekly = na
var label htf_label_monthly = na
var label htf_label_quarterly = na
var label htf_label_halfyear = na
var label htf_label_yearly = na

f_manage_htf_ema_level(bool should_display, float ema_value, color line_color, int line_width, line line_ref, label label_ref, string label_prefix) =>
    line updated_line = line_ref
    label updated_label = label_ref
    if should_display and not na(ema_value)
        int line_left = bar_index - i_htf_line_length
        int line_right = bar_index + i_htf_extend_right
        color faded_color = color.new(line_color, i_htf_transparency)
        if na(updated_line)
            updated_line := line.new(line_left, ema_value, line_right, ema_value, xloc.bar_index, extend.none, faded_color, htf_line_style_val, line_width)
        else
            line.set_xy1(updated_line, line_left, ema_value)
            line.set_xy2(updated_line, line_right, ema_value)
            line.set_color(updated_line, faded_color)
            line.set_style(updated_line, htf_line_style_val)
            line.set_width(updated_line, line_width)
        if i_htf_show_labels
            string label_text = label_prefix + ": " + str.tostring(ema_value, format.mintick)
            if na(updated_label)
                updated_label := label.new(line_right, ema_value, label_text, xloc.bar_index, yloc.price, line_color, label.style_label_left, color.white, htf_label_size_val)
            else
                label.set_xy(updated_label, line_right, ema_value)
                label.set_text(updated_label, label_text)
                label.set_color(updated_label, line_color)
                label.set_size(updated_label, htf_label_size_val)
        else
            if not na(updated_label)
                label.delete(updated_label)
                updated_label := na
    else
        if not na(updated_line)
            line.delete(updated_line)
            updated_line := na
        if not na(updated_label)
            label.delete(updated_label)
            updated_label := na
    [updated_line, updated_label]

f_create_zone(is_demand, proximal, distal, start_bar, is_exceptional) =>
    zone_enabled = (is_demand and i_show_demand) or (not is_demand and i_show_supply)
    if zone_enabled and barstate.isconfirmed
        z_top = math.max(proximal, distal)
        z_bot = math.min(proximal, distal)
        col_base = is_demand ? (is_exceptional ? i_exceptional_demand_color : i_demand_color) : (is_exceptional ? i_exceptional_supply_color : i_supply_color)
        bg_col = i_only_zone_border ? na : col_base
        b_alpha = i_only_zone_border ? 0 : 40
        b = box.new(start_bar, z_top, bar_index, z_bot, bgcolor = bg_col, border_width = i_border_width, border_color = color.new(col_base, b_alpha), extend = extend.right)
        box.set_border_style(b, border_style)
        l_prox = line.new(start_bar, proximal, bar_index, proximal, color = color.new(col_base, 0), width = i_zone_line_width, style = zone_line_style, extend = extend.right)
        l_dist = line.new(start_bar, distal, bar_index, distal, color = color.new(col_base, 0), width = i_zone_line_width, style = zone_line_style, extend = extend.right)
        off = int(bar_index - start_bar)
        st = off >= 0 ? time[off] : time
        lb = label.new(st, proximal, "", xloc = xloc.bar_time, style = label.style_label_left, textcolor = i_text_color, size = text_size, color = na)
        if not i_show_prox_line
            line.set_color(l_prox, na)
        if not i_show_dist_line
            line.set_color(l_dist, na)
        array.push(zone_boxes, b)
        array.push(zone_prox_lines, l_prox)
        array.push(zone_dist_lines, l_dist)
        array.push(zone_labels, lb)
        array.push(zone_start_time, st)
        array.push(zone_tops, z_top)
        array.push(zone_bottoms, z_bot)
        array.push(zone_is_demand, is_demand)
        array.push(zone_test_count, 0)
        array.push(zone_last_test_bar, na)
        array.push(zone_is_exceptional, is_exceptional)
        array.push(zone_origin_enabled, false)
        array.push(zone_bar, bar_index)
        array.push(zone_legout_count, 1)

f_create_origin_zone(proximal, distal, start_bar, col) =>
    if barstate.isconfirmed
        z_top = math.max(proximal, distal)
        z_bot = math.min(proximal, distal)
        bg_col = i_only_zone_border ? na : col
        b_alpha = i_only_zone_border ? 0 : 40
        b = box.new(start_bar, z_top, bar_index, z_bot, bgcolor = bg_col, border_width = i_border_width, border_color = color.new(col, b_alpha), extend = extend.right)
        box.set_border_style(b, border_style)
        l_prox = line.new(start_bar, proximal, bar_index, proximal, color = color.new(col, 0), width = i_zone_line_width, style = zone_line_style, extend = extend.right)
        l_dist = line.new(start_bar, distal, bar_index, distal, color = color.new(col, 0), width = i_zone_line_width, style = zone_line_style, extend = extend.right)
        off = int(bar_index - start_bar)
        st = off >= 0 ? time[off] : time
        lb = label.new(st, proximal, "", xloc = xloc.bar_time, style = label.style_label_left, textcolor = i_text_color, size = text_size, color = na)
        if not i_show_prox_line
            line.set_color(l_prox, na)
        if not i_show_dist_line
            line.set_color(l_dist, na)
        array.push(origin_boxes, b)
        array.push(origin_prox_lines, l_prox)
        array.push(origin_dist_lines, l_dist)
        array.push(origin_labels, lb)
        array.push(origin_start_time, st)
        array.push(origin_tops, z_top)
        array.push(origin_bottoms, z_bot)

f_update_origin_visibility(idx) =>
    enabled = array.get(zone_origin_enabled, idx)
    is_demand_zone = array.get(zone_is_demand, idx)
    test_count = array.get(zone_test_count, idx)
    is_tested_zone = test_count >= 1
    is_exceptional_zone = array.get(zone_is_exceptional, idx)
    color col = na
    if enabled
        if test_count >= 2
            col := i_tested_color
        else if test_count == 1
            col := i_tested_once_color
        else if is_exceptional_zone
            col := is_demand_zone ? i_exceptional_demand_color : i_exceptional_supply_color
        else
            col := is_demand_zone ? i_demand_color : i_supply_color
        if (is_demand_zone and not i_show_demand) or (not is_demand_zone and not i_show_supply)
            col := na
        if is_tested_zone and not i_show_tested
            col := na
        if test_count == 1 and not i_show_tested_once
            col := na
    b = array.get(origin_boxes, idx)
    l_prox = array.get(origin_prox_lines, idx)
    l_dist = array.get(origin_dist_lines, idx)
    lb = array.get(origin_labels, idx)
    st = array.get(origin_start_time, idx)
    box.set_bgcolor(b, (na(col) or i_only_zone_border) ? na : col)
    b_alpha = i_only_zone_border ? 0 : 40
    box.set_border_color(b, na(col) ? na : color.new(col, b_alpha))
    box.set_border_width(b, i_border_width)
    box.set_border_style(b, border_style)
    if not i_show_prox_line or na(col)
        line.set_color(l_prox, na)
    else
        line.set_color(l_prox, color.new(col, 0))
    line.set_width(l_prox, i_zone_line_width)
    line.set_style(l_prox, zone_line_style)
    if not i_show_dist_line or na(col)
        line.set_color(l_dist, na)
    else
        line.set_color(l_dist, color.new(col, 0))
    line.set_width(l_dist, i_zone_line_width)
    line.set_style(l_dist, zone_line_style)
    o_top = array.get(origin_tops, idx)
    o_bot = array.get(origin_bottoms, idx)
    proximal = is_demand_zone ? o_top : o_bot
    distal = is_demand_zone ? o_bot : o_top
    show_text = i_show_zone_values and not na(col)
    txt = ""
    if show_text
        if i_show_score
            string pattern = array.get(zone_pattern_type, idx)
            int test_cnt = array.get(zone_test_count, idx)
            int lo_count = array.get(zone_legout_count, idx)
            bool has_gap_flag = array.get(zone_has_gap, idx)
            int base_cnt = array.get(zone_base_count, idx)
            float core_score = f_calc_core_score(test_cnt, lo_count, has_gap_flag, base_cnt)
            bool strong_close = array.get(zone_strong_closing, idx)
            string close_flag = ""
            if i_show_closing_flag
                close_flag := strong_close ? " ✓" : " ✗"
            string gap_flag = has_gap_flag ? " G" : ""
            string test_flag = test_cnt > 0 ? " T:" + str.tostring(test_cnt) : ""
            if i_show_pattern
                txt += pattern + " "
            txt += str.tostring(core_score, "#.#") + "/7" + close_flag + gap_flag + test_flag
        if i_show_prox_value
            if str.length(txt) > 0
                txt += "\n"
            txt += "P: " + str.tostring(proximal, format.mintick)
        if i_show_dist_value
            if str.length(txt) > 0
                txt += "\n"
            txt += "D: " + str.tostring(distal, format.mintick)
        if i_show_risk
            if str.length(txt) > 0
                txt += "\n"
            txt += "R: " + str.tostring(math.abs(proximal - distal), format.mintick)
    label.set_x(lb, st)
    label.set_y(lb, proximal)
    label.set_text(lb, txt)
    label.set_textcolor(lb, show_text ? i_text_color : na)
    label.set_size(lb, text_size)
    label.set_color(lb, na)

// Check if a Daily demand zone has an opposing Weekly/Monthly supply zone within X% above it
// Check if a Daily supply zone has an opposing Weekly/Monthly demand zone within X% below it
f_check_zone_conflict(int zone_idx) =>
    bool has_conflict = false
    string conflict_detail = ""
    if not i_show_conflict
        [false, ""]
    else
        bool is_demand_z = array.get(zone_is_demand, zone_idx)
        float z_top = array.get(zone_tops, zone_idx)
        float z_bot = array.get(zone_bottoms, zone_idx)
        float z_proximal = is_demand_z ? z_top : z_bot
        float conflict_range = z_proximal * (i_conflict_distance_pct / 100.0)

        // Check against Weekly zones
        if array.size(w_zone_boxes) > 0
            for j = 0 to array.size(w_zone_boxes) - 1
                bool w_is_demand = array.get(w_zone_is_demand, j)
                int w_test_cnt = array.get(w_zone_test_count, j)
                // Conflict = opposing direction AND fresh or tested-once
                if is_demand_z != w_is_demand and w_test_cnt < 2
                    float w_prox = w_is_demand ? array.get(w_zone_tops, j) : array.get(w_zone_bottoms, j)
                    if is_demand_z
                        if w_prox > z_proximal and w_prox - z_proximal <= conflict_range
                            has_conflict := true
                            conflict_detail := "W SZ @ " + str.tostring(w_prox, format.mintick)
                            break
                    else
                        if w_prox < z_proximal and z_proximal - w_prox <= conflict_range
                            has_conflict := true
                            conflict_detail := "W DZ @ " + str.tostring(w_prox, format.mintick)
                            break

        // Check against Monthly zones (higher priority)
        if array.size(m_zone_boxes) > 0
            for j = 0 to array.size(m_zone_boxes) - 1
                bool m_is_demand = array.get(m_zone_is_demand, j)
                int m_test_cnt = array.get(m_zone_test_count, j)
                if is_demand_z != m_is_demand and m_test_cnt < 2
                    float m_prox = m_is_demand ? array.get(m_zone_tops, j) : array.get(m_zone_bottoms, j)
                    if is_demand_z
                        if m_prox > z_proximal and m_prox - z_proximal <= conflict_range
                            has_conflict := true
                            conflict_detail := "M SZ @ " + str.tostring(m_prox, format.mintick)
                            break
                    else
                        if m_prox < z_proximal and z_proximal - m_prox <= conflict_range
                            has_conflict := true
                            conflict_detail := "M DZ @ " + str.tostring(m_prox, format.mintick)
                            break

        [has_conflict, conflict_detail]

f_update_zone_visibility(idx) =>
    is_demand_zone = array.get(zone_is_demand, idx)
    test_count = array.get(zone_test_count, idx)
    is_tested_zone = test_count >= 1
    is_exceptional_zone = array.get(zone_is_exceptional, idx)
    color col = na
    if test_count >= 2
        col := i_tested_color
    else if test_count == 1
        col := i_tested_once_color
    else if is_exceptional_zone
        col := is_demand_zone ? i_exceptional_demand_color : i_exceptional_supply_color
    else
        col := is_demand_zone ? i_demand_color : i_supply_color
    if (is_demand_zone and not i_show_demand) or (not is_demand_zone and not i_show_supply)
        col := na
    if is_tested_zone and not i_show_tested
        col := na
    if test_count == 1 and not i_show_tested_once
        col := na
    b = array.get(zone_boxes, idx)
    l_prox = array.get(zone_prox_lines, idx)
    l_dist = array.get(zone_dist_lines, idx)
    lb = array.get(zone_labels, idx)
    st = array.get(zone_start_time, idx)
    box.set_bgcolor(b, (na(col) or i_only_zone_border) ? na : col)
    b_alpha = i_only_zone_border ? 0 : 40
    box.set_border_color(b, na(col) ? na : color.new(col, b_alpha))
    box.set_border_width(b, i_border_width)
    box.set_border_style(b, border_style)
    if not i_show_prox_line or na(col)
        line.set_color(l_prox, na)
    else
        line.set_color(l_prox, color.new(col, 0))
    line.set_width(l_prox, i_zone_line_width)
    line.set_style(l_prox, zone_line_style)
    if not i_show_dist_line or na(col)
        line.set_color(l_dist, na)
    else
        line.set_color(l_dist, color.new(col, 0))
    line.set_width(l_dist, i_zone_line_width)
    line.set_style(l_dist, zone_line_style)
    if i_show_conflict and not na(col)
        [is_conflicting, conflict_info] = f_check_zone_conflict(idx)
        if is_conflicting
            box.set_border_color(array.get(zone_boxes, idx), i_conflict_border_color)
            box.set_border_width(array.get(zone_boxes, idx), math.max(i_border_width, 2))

    proximal = is_demand_zone ? array.get(zone_tops, idx) : array.get(zone_bottoms, idx)
    distal = is_demand_zone ? array.get(zone_bottoms, idx) : array.get(zone_tops, idx)
    show_text = i_show_zone_values and not na(col)
    txt = ""
    if show_text
        if i_show_score
            string pattern = array.get(zone_pattern_type, idx)
            int test_cnt = array.get(zone_test_count, idx)
            int lo_count = array.get(zone_legout_count, idx)
            bool has_gap_flag = array.get(zone_has_gap, idx)
            int base_cnt = array.get(zone_base_count, idx)
            float core_score = f_calc_core_score(test_cnt, lo_count, has_gap_flag, base_cnt)
            bool strong_close = array.get(zone_strong_closing, idx)
            string close_flag = ""
            if i_show_closing_flag
                close_flag := strong_close ? " ✓" : " ✗"
            string gap_flag = has_gap_flag ? " G" : ""
            string test_flag = test_cnt > 0 ? " T:" + str.tostring(test_cnt) : ""
            if i_show_pattern
                txt += pattern + " "
            txt += str.tostring(core_score, "#.#") + "/7" + close_flag + gap_flag + test_flag
        if i_show_prox_value
            if str.length(txt) > 0
                txt += "\n"
            txt += "P: " + str.tostring(proximal, format.mintick)
        if i_show_dist_value
            if str.length(txt) > 0
                txt += "\n"
            txt += "D: " + str.tostring(distal, format.mintick)
        if i_show_risk
            if str.length(txt) > 0
                txt += "\n"
            txt += "R: " + str.tostring(math.abs(proximal - distal), format.mintick)
        if i_show_conflict
            [is_conflicting, conflict_info] = f_check_zone_conflict(idx)
            if is_conflicting
                if str.length(txt) > 0
                    txt += "\n"
                txt += "⚠ " + conflict_info
    label.set_x(lb, st)
    label.set_y(lb, proximal)
    label.set_text(lb, txt)
    label.set_textcolor(lb, show_text ? i_text_color : na)
    label.set_size(lb, text_size)
    label.set_color(lb, na)

f_create_weekly_zone(is_demand, proximal, distal, start_bar, is_exceptional) =>
    zone_enabled = (is_demand and i_show_weekly_demand) or (not is_demand and i_show_weekly_supply)
    if zone_enabled and barstate.isconfirmed
        z_top = math.max(proximal, distal)
        z_bot = math.min(proximal, distal)
        col_base = is_demand ? (is_exceptional ? i_weekly_exceptional_demand_color : i_weekly_demand_color) : (is_exceptional ? i_weekly_exceptional_supply_color : i_weekly_supply_color)
        bg_col = i_only_zone_border ? na : col_base
        b_alpha = i_only_zone_border ? 0 : 40
        b = box.new(start_bar, z_top, bar_index, z_bot, bgcolor = bg_col, border_width = i_border_width, border_color = color.new(col_base, b_alpha), extend = extend.right)
        box.set_border_style(b, border_style)
        l_prox = line.new(start_bar, proximal, bar_index, proximal, color = color.new(col_base, 0), width = i_zone_line_width, style = weekly_line_style, extend = extend.right)
        l_dist = line.new(start_bar, distal, bar_index, distal, color = color.new(col_base, 0), width = i_zone_line_width, style = weekly_line_style, extend = extend.right)
        lb = label.new(time, proximal, "W", xloc = xloc.bar_time, style = label.style_label_left, textcolor = i_text_color, size = text_size, color = na)
        if not i_show_prox_line
            line.set_color(l_prox, na)
        if not i_show_dist_line
            line.set_color(l_dist, na)
        array.push(w_zone_boxes, b)
        array.push(w_zone_prox_lines, l_prox)
        array.push(w_zone_dist_lines, l_dist)
        array.push(w_zone_labels, lb)
        array.push(w_zone_tops, z_top)
        array.push(w_zone_bottoms, z_bot)
        array.push(w_zone_is_demand, is_demand)
        array.push(w_zone_test_count, 0)
        array.push(w_zone_last_test_bar, na)
        array.push(w_zone_is_exceptional, is_exceptional)
        array.push(w_zone_origin_enabled, false)
        array.push(w_zone_bar, w_seq)
        array.push(w_zone_legout_count, 1)

