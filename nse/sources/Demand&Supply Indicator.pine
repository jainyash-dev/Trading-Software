        lb = label.new(time, proximal, "", xloc = xloc.bar_time, style = label.style_label_left, textcolor = i_text_color, size = text_size, color = na)
        if not i_show_prox_line
            line.set_color(l_prox, na)
        if not i_show_dist_line
            line.set_color(l_dist, na)
        array.push(w_origin_boxes, b)
