//@version=6
indicator(title = "D&S Zone Engine", shorttitle = "D&S Zones", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

group_zone = "Zone Marking Settings"
i_show_demand = input.bool(true, "Demand Zone", group = group_zone, inline = "zones")
i_demand_color = input.color(color.new(color.rgb(76, 175, 80), 80), "", group = group_zone, inline = "zones")
i_show_supply = input.bool(true, "Supply Zone", group = group_zone, inline = "zones")
i_supply_color = input.color(color.new(color.red, 80), "", group = group_zone, inline = "zones")
i_zone_method = input.string("Body to Wick", "Zone Marking Method", options = ["Body to Wick", "Wick to Wick"], group = group_zone)
i_max_base_candles = input.int(3, "Max Base Candles", options = [1, 2, 3, 4, 5], group = group_zone)
i_base_threshold = input.float(0.5, "Base Body Ratio Threshold", options = [0.3, 0.4, 0.5, 0.6, 0.7], group = group_zone)
i_legout_threshold = input.float(0.5, "Leg-Out Body Ratio Threshold", options = [0.5, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0], group = group_zone)

group_exceptional = "Exceptional Zones"
i_enable_exceptional = input.bool(true, "Enable Exceptional Zone Detection", group = group_exceptional)
i_exceptional_demand_color = input.color(color.new(color.rgb(76, 175, 80), 80), "Exceptional Demand Zone Color", group = group_exceptional)
i_exceptional_supply_color = input.color(color.new(color.red, 80), "Exceptional Supply Zone Color", group = group_exceptional)

group_border = "Zone Border Settings"
i_only_zone_border = input.bool(false, "Only Zone Border", group = group_border)
i_border_width = input.int(1, "Border Width", minval = 1, maxval = 3, group = group_border)
i_border_style = input.string("Solid", "Border Style", options = ["Solid", "Dashed", "Dotted"], group = group_border)
i_show_prox_line = input.bool(true, "Show Proximal Line", group = group_border)
i_show_dist_line = input.bool(true, "Show Distal Line", group = group_border)
i_zone_line_width = input.int(1, "Zone Line Width", minval = 1, maxval = 3, group = group_border)
i_zone_line_style = input.string("Solid", "Zone Line Style", options = ["Solid", "Dashed", "Dotted"], group = group_border)

group_info = "Zone Information"
i_show_zone_values = input.bool(true, "Show Zone Values", group = group_info)
i_show_prox_value = input.bool(true, "Show Proximal Value", group = group_info, inline = "vals")
i_show_dist_value = input.bool(true, "Show Distal Value", group = group_info, inline = "vals")
i_show_risk = input.bool(true, "Show Risk", group = group_info)
i_text_color = input.color(color.black, "Text Color", group = group_info)
i_text_size = input.string("Tiny", "Text Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = group_info)

group_score = "Zone Score Display"
i_show_score = input.bool(true, "Show Zone Score", group = group_score)
i_show_pattern = input.bool(true, "Show Pattern Type", group = group_score)
i_show_closing_flag = input.bool(true, "Show Closing Flag", group = group_score)

group_tested = "Tested Zones"
i_show_tested = input.bool(true, "Show Tested Zones", group = group_tested)
i_show_tested_once = input.bool(true, "Show Tested-Once Zones", group = group_tested)
i_tested_once_color = input.color(color.new(color.yellow, 70), "Tested Once Zone Color", group = group_tested)
i_tested_color = input.color(color.new(color.gray, 70), "Tested Zone Color", group = group_tested)

group_weekly = "Weekly Zones"
i_show_weekly_demand = input.bool(true, "Weekly Demand Zone", group = group_weekly, inline = "w_demand")
i_weekly_demand_color = input.color(color.new(color.blue, 75), "", group = group_weekly, inline = "w_demand")
i_show_weekly_supply = input.bool(true, "Weekly Supply Zone", group = group_weekly, inline = "w_supply")
i_weekly_supply_color = input.color(color.new(color.orange, 75), "", group = group_weekly, inline = "w_supply")
i_weekly_exceptional_demand_color = input.color(color.new(color.blue, 70), "Exceptional Weekly Demand", group = group_weekly)
i_weekly_exceptional_supply_color = input.color(color.new(color.orange, 70), "Exceptional Weekly Supply", group = group_weekly)
i_weekly_line_style = input.string("Dashed", "Weekly Zone Line Style", options = ["Solid", "Dashed", "Dotted"], group = group_weekly)
i_show_tested_weekly = input.bool(true, "Show Tested Weekly Zones", group = group_weekly)
i_tested_weekly_color = input.color(color.new(color.gray, 75), "Tested Weekly Zone Color", group = group_weekly)

group_monthly = "Monthly Zones"
i_show_monthly_demand = input.bool(true, "Monthly Demand Zone", group = group_monthly, inline = "m_demand")
i_monthly_demand_color = input.color(color.new(color.purple, 75), "", group = group_monthly, inline = "m_demand")
i_show_monthly_supply = input.bool(true, "Monthly Supply Zone", group = group_monthly, inline = "m_supply")
i_monthly_supply_color = input.color(color.new(color.maroon, 75), "", group = group_monthly, inline = "m_supply")
i_monthly_exceptional_demand_color = input.color(color.new(color.purple, 70), "Exceptional Monthly Demand", group = group_monthly)
i_monthly_exceptional_supply_color = input.color(color.new(color.maroon, 70), "Exceptional Monthly Supply", group = group_monthly)
i_monthly_line_style = input.string("Dotted", "Monthly Zone Line Style", options = ["Solid", "Dashed", "Dotted"], group = group_monthly)
i_show_tested_monthly = input.bool(true, "Show Tested Monthly Zones", group = group_monthly)
i_tested_monthly_color = input.color(color.new(color.gray, 70), "Tested Monthly Zone Color", group = group_monthly)

group_conflict = "HTF Conflict Warning"
i_show_conflict = input.bool(true, "Enable HTF Conflict Warning", group = group_conflict)
i_conflict_distance_pct = input.float(5.0, "Conflict Distance %", group = group_conflict, minval = 1.0, maxval = 20.0, step = 0.5, tooltip = "Maximum % distance between a Daily zone and an opposing HTF zone to flag as conflict. E.g., 5% means a Daily DZ with a Monthly SZ within 5% above will be flagged.")
i_conflict_border_color = input.color(color.new(color.fuchsia, 0), "Conflict Border Color", group = group_conflict)

group_sector = "Sector & Market Alignment"
i_show_sector = input.bool(true, "Show Sector Alignment", group = group_sector)
i_nifty_symbol = input.symbol("NSE:NIFTY", "Nifty Symbol", group = group_sector)
i_sector_symbol = input.symbol("NSE:BANKNIFTY", "Sector Index Symbol", group = group_sector, tooltip = "Choose your stock's parent sector index: NSE:BANKNIFTY, NSE:CNXIT, NSE:CNXAUTO, NSE:CNXPHARMA, NSE:CNXMETAL, etc.")

// ══════════════════════════════════════════════════════════════════════════════
// TREND ENGINE INPUTS
// ══════════════════════════════════════════════════════════════════════════════

var string GRP_TREND = "═══ Trend EMAs ═══"
var string GRP_CROSS = "═══ Cross Signals ═══"
var string GRP_HTF_EMA = "═══ HTF EMA Levels ═══"

// ── Trend EMAs ───────────────────────────────────────────────────────────────
i_show_trend_emas = input.bool(true, "Show Trend EMAs", group = GRP_TREND, tooltip = "Master toggle for EMA 20, 50, and 200 lines.")

i_show_ema20 = input.bool(true, "Show EMA 20", group = GRP_TREND, inline = "ema20")
i_ema20_color = input.color(#2196F3, "", group = GRP_TREND, inline = "ema20")
i_ema20_width = input.int(1, "", group = GRP_TREND, inline = "ema20", minval = 1, maxval = 4)

i_show_ema50 = input.bool(true, "Show EMA 50", group = GRP_TREND, inline = "ema50")
i_ema50_color = input.color(#FF9800, "", group = GRP_TREND, inline = "ema50")
i_ema50_width = input.int(1, "", group = GRP_TREND, inline = "ema50", minval = 1, maxval = 4)

i_show_ema200 = input.bool(true, "Show EMA 200", group = GRP_TREND, inline = "ema200")
i_ema200_color = input.color(#F44336, "", group = GRP_TREND, inline = "ema200")
i_ema200_width = input.int(2, "", group = GRP_TREND, inline = "ema200", minval = 1, maxval = 4)
i_ema200_type = input.string("SMA", "EMA 200 Type", options = ["EMA", "SMA"], group = GRP_TREND, tooltip = "SMA matches the conventional '200 DMA' watched by institutions. EMA reacts faster.")

i_show_sma50_trend = input.bool(true, "Show SMA 50 Trend Line", group = GRP_TREND, inline = "sma50")
i_sma50_width = input.int(2, "", group = GRP_TREND, inline = "sma50", minval = 1, maxval = 4)
i_sma50_up_color = input.color(color.green, "Up", group = GRP_TREND, inline = "sma50col")
i_sma50_down_color = input.color(color.red, "Down", group = GRP_TREND, inline = "sma50col")
i_sma50_flat_color = input.color(color.gray, "Flat", group = GRP_TREND, inline = "sma50col")

i_show_trend_bg = input.bool(false, "Show Trend Background", group = GRP_TREND, tooltip = "Tints chart background green (uptrend), red (downtrend), or gray (ranging). Subtle effect.")

// ── Cross Signals ────────────────────────────────────────────────────────────
i_show_major_cross = input.bool(true, "Show Major Crosses (EMA50 × EMA200)", group = GRP_CROSS, tooltip = "Golden Cross: EMA50 crosses above EMA200. Death Cross: EMA50 crosses below EMA200.")
i_major_gc_color = input.color(color.green, "Golden Cross Color", group = GRP_CROSS, inline = "majorcol")
i_major_dc_color = input.color(color.red, "Death Cross Color", group = GRP_CROSS, inline = "majorcol")

i_show_minor_cross = input.bool(true, "Show Minor Crosses (EMA20 × EMA50)", group = GRP_CROSS, tooltip = "Minor Golden: EMA20 crosses above EMA50. Minor Death: EMA20 crosses below EMA50.")
i_minor_gc_color = input.color(color.yellow, "Minor Golden Color", group = GRP_CROSS, inline = "minorcol")
i_minor_dc_color = input.color(#FF5252, "Minor Death Color", group = GRP_CROSS, inline = "minorcol")

// ── HTF EMA Levels ───────────────────────────────────────────────────────────
i_show_htf_ema_levels = input.bool(true, "Show HTF EMA 20 Levels", group = GRP_HTF_EMA, tooltip = "Master toggle for all HTF EMA 20 horizontal levels. Each HTF level only shows on timeframes BELOW that HTF.")

i_show_weekly_ema20 = input.bool(true, "Weekly EMA 20", group = GRP_HTF_EMA, inline = "wema")
i_weekly_ema20_color = input.color(#9C27B0, "", group = GRP_HTF_EMA, inline = "wema")
i_weekly_ema20_width = input.int(1, "", group = GRP_HTF_EMA, inline = "wema", minval = 1, maxval = 4)

i_show_monthly_ema20 = input.bool(true, "Monthly EMA 20", group = GRP_HTF_EMA, inline = "mema")
i_monthly_ema20_color = input.color(#009688, "", group = GRP_HTF_EMA, inline = "mema")
i_monthly_ema20_width = input.int(1, "", group = GRP_HTF_EMA, inline = "mema", minval = 1, maxval = 4)

i_show_quarterly_ema20 = input.bool(true, "Quarterly EMA 20", group = GRP_HTF_EMA, inline = "qema")
i_quarterly_ema20_color = input.color(#FF5722, "", group = GRP_HTF_EMA, inline = "qema")
i_quarterly_ema20_width = input.int(1, "", group = GRP_HTF_EMA, inline = "qema", minval = 1, maxval = 4)

i_show_halfyear_ema20 = input.bool(true, "Half-Yearly EMA 20", group = GRP_HTF_EMA, inline = "hyema")
i_halfyear_ema20_color = input.color(#673AB7, "", group = GRP_HTF_EMA, inline = "hyema")
i_halfyear_ema20_width = input.int(1, "", group = GRP_HTF_EMA, inline = "hyema", minval = 1, maxval = 4)

i_show_yearly_ema20 = input.bool(true, "Yearly EMA 20", group = GRP_HTF_EMA, inline = "yema")
i_yearly_ema20_color = input.color(#795548, "", group = GRP_HTF_EMA, inline = "yema")
i_yearly_ema20_width = input.int(1, "", group = GRP_HTF_EMA, inline = "yema", minval = 1, maxval = 4)

i_htf_line_length = input.int(100, "Line Length (bars back)", group = GRP_HTF_EMA, minval = 20, maxval = 500, tooltip = "How far left the HTF level lines extend.")
i_htf_extend_right = input.int(20, "Extend Right (bars)", group = GRP_HTF_EMA, minval = 5, maxval = 100, tooltip = "Extend horizontal line to the right toward the price scale.")
i_htf_line_style = input.string("Dotted", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = GRP_HTF_EMA)
i_htf_transparency = input.int(50, "Line Transparency %", group = GRP_HTF_EMA, minval = 0, maxval = 90)
i_htf_show_labels = input.bool(true, "Show Price Labels", group = GRP_HTF_EMA, tooltip = "Display current EMA value label on the right side.")
i_htf_label_size = input.string("small", "Label Size", options = ["tiny", "small", "normal"], group = GRP_HTF_EMA)

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD 1 — MARKET INFORMATION
// ══════════════════════════════════════════════════════════════════════════════

var string GRP_DASH1 = "═══ Dashboard 1 — Market Info ═══"

i_show_dash1 = input.bool(true, "Show Dashboard 1", group = GRP_DASH1, tooltip = "Master toggle for Market Information dashboard.")

i_dash1_position = input.string("Top Right", "Position", group = GRP_DASH1, options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"])

i_dash1_bg = input.color(color.new(#1E1E1E, 10), "Background", group = GRP_DASH1, inline = "d1theme1")
i_dash1_text = input.color(color.new(#E0E0E0, 0), "Text", group = GRP_DASH1, inline = "d1theme1")
i_dash1_border = input.color(color.new(#424242, 0), "Border", group = GRP_DASH1, inline = "d1theme2")
i_dash1_transp = input.int(10, "Transparency %", group = GRP_DASH1, inline = "d1theme2", minval = 0, maxval = 90)

i_dash1_text_size = input.string("Tiny", "Text Size", group = GRP_DASH1, options = ["Tiny", "Small", "Normal", "Large"])

i_dash1_show_volume = input.bool(true, "Show Volume", group = GRP_DASH1, tooltip = "Display current volume, average, ratio, and highest volume.")
i_dash1_vol_lookback = input.int(10, "Volume Lookback (bars)", group = GRP_DASH1, minval = 1, maxval = 500)

i_dash1_show_atr = input.bool(true, "Show ATR", group = GRP_DASH1, tooltip = "Display ATR value and ATR as percentage of price.")
i_dash1_atr_period = input.int(14, "ATR Period", group = GRP_DASH1, minval = 1, maxval = 100)

i_dash1_show_rsi = input.bool(true, "Show RSI", group = GRP_DASH1, tooltip = "Display RSI value and overbought/oversold state.")
i_dash1_rsi_period = input.int(14, "RSI Period", group = GRP_DASH1, minval = 1, maxval = 100)

i_dash1_show_zone_count = input.bool(true, "Show Zone Counts", group = GRP_DASH1, tooltip = "Display count of active fresh zones (Daily, Weekly, Monthly).")
i_dash1_show_zone_dist = input.bool(true, "Show Zone Distance", group = GRP_DASH1, tooltip = "Display distance to nearest fresh demand and supply zones.")

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD 2 — TREND OVERVIEW
// ══════════════════════════════════════════════════════════════════════════════

var string GRP_DASH2 = "═══ Dashboard 2 — Trend Overview ═══"

i_show_dash2 = input.bool(true, "Show Dashboard 2", group = GRP_DASH2, tooltip = "Master toggle for Trend Overview dashboard.")

i_dash2_position = input.string("Bottom Right", "Position", group = GRP_DASH2, options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"])

i_dash2_bg = input.color(color.new(#1E1E1E, 10), "Background", group = GRP_DASH2, inline = "d2theme1")
i_dash2_text = input.color(color.new(#E0E0E0, 0), "Text", group = GRP_DASH2, inline = "d2theme1")
i_dash2_border = input.color(color.new(#424242, 0), "Border", group = GRP_DASH2, inline = "d2theme2")
i_dash2_transp = input.int(10, "Transparency %", group = GRP_DASH2, inline = "d2theme2", minval = 0, maxval = 90)

i_dash2_text_size = input.string("Tiny", "Text Size", group = GRP_DASH2, options = ["Tiny", "Small", "Normal", "Large"])

i_dash2_show_daily_trend = input.bool(true, "Show Col 1 SMA50", group = GRP_DASH2, tooltip = "D/D below | W/Weekly | M/Monthly | Q/Quarterly | HY/HalfYear+")
i_dash2_show_weekly_trend = input.bool(true, "Show Col 2 SMA50", group = GRP_DASH2, tooltip = "W | M | Q | HY | Y")
i_dash2_show_monthly_trend = input.bool(true, "Show Col 3 SMA50", group = GRP_DASH2, tooltip = "M | Q | HY | Y")

i_dash2_show_daily_emas = input.bool(true, "Show Daily EMA Values", group = GRP_DASH2, tooltip = "Display current TF EMA 20, EMA 50, and EMA/SMA 200 values.")
i_dash2_show_htf_emas = input.bool(true, "Show HTF EMA Values", group = GRP_DASH2, tooltip = "Display Weekly and Monthly EMA 20 values.")

i_dash2_show_ema_msg = input.bool(true, "Show EMA Message", group = GRP_DASH2, tooltip = "Display which EMA price is heading towards based on distance.")
i_dash2_show_clock = input.bool(true, "Show SMA50 Clock Angle", group = GRP_DASH2, tooltip = "Display the SMA50 trend angle as a clock position (12=extreme up, 3=flat, 6=extreme down)")
i_clock_lookback = input.int(5, "Clock Lookback Bars", group = GRP_DASH2, minval = 2, maxval = 20, tooltip = "Number of bars to measure SMA50 slope. Higher = smoother, lower = more responsive.")

i_dash2_ranging_pct = input.float(0.1, "Ranging Threshold %", group = GRP_DASH2, minval = 0.01, maxval = 1.0, step = 0.01, tooltip = "SMA50 change below this % is treated as Ranging (flat trend). Prevents tiny fluctuations from showing Uptrend/Downtrend.")

current_tf_seconds = timeframe.in_seconds()
weekly_tf_seconds = timeframe.in_seconds("W")
monthly_tf_seconds = timeframe.in_seconds("M")

show_weekly_zones = current_tf_seconds < weekly_tf_seconds
show_monthly_zones = current_tf_seconds < monthly_tf_seconds

// ══════════════════════════════════════════════════════════════════════════════
// TREND ENGINE - TIMEFRAME CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

trend_current_tf_seconds = timeframe.in_seconds()
trend_weekly_seconds = timeframe.in_seconds("W")
trend_monthly_seconds = timeframe.in_seconds("M")
trend_quarterly_seconds = timeframe.in_seconds("3M")
trend_halfyear_seconds = timeframe.in_seconds("6M")
trend_yearly_seconds = timeframe.in_seconds("12M")

can_show_weekly_ema = trend_current_tf_seconds < trend_weekly_seconds
can_show_monthly_ema = trend_current_tf_seconds < trend_monthly_seconds
can_show_quarterly_ema = trend_current_tf_seconds < trend_quarterly_seconds
can_show_halfyear_ema = trend_current_tf_seconds < trend_halfyear_seconds
can_show_yearly_ema = trend_current_tf_seconds < trend_yearly_seconds

display_weekly_ema = i_show_htf_ema_levels and i_show_weekly_ema20 and can_show_weekly_ema
display_monthly_ema = i_show_htf_ema_levels and i_show_monthly_ema20 and can_show_monthly_ema
display_quarterly_ema = i_show_htf_ema_levels and i_show_quarterly_ema20 and can_show_quarterly_ema
display_halfyear_ema = i_show_htf_ema_levels and i_show_halfyear_ema20 and can_show_halfyear_ema
display_yearly_ema = i_show_htf_ema_levels and i_show_yearly_ema20 and can_show_yearly_ema

// ══════════════════════════════════════════════════════════════════════════════
// TREND ENGINE - EMA CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

trend_ema20 = ta.ema(close, 20)
trend_ema50 = ta.ema(close, 50)
trend_ema200 = i_ema200_type == "SMA" ? ta.sma(close, 200) : ta.ema(close, 200)
trend_sma50 = ta.sma(close, 50)

trend_sma50_rising = trend_sma50 > trend_sma50[1]
trend_sma50_falling = trend_sma50 < trend_sma50[1]
trend_state = trend_sma50_rising ? "UPTREND" : trend_sma50_falling ? "DOWNTREND" : "RANGING"
trend_sma50_color = trend_sma50_rising ? i_sma50_up_color : trend_sma50_falling ? i_sma50_down_color : i_sma50_flat_color
sma50_change_pct = trend_sma50 != 0 ? ((trend_sma50 - trend_sma50[i_clock_lookback]) / trend_sma50) * 100 : 0.0
string clock_position = ""
string clock_emoji = ""
color clock_color = color.gray
if sma50_change_pct > 2.0
    clock_position := "12 o'clock"
    clock_emoji := "⬆"
    clock_color := color.new(color.green, 0)
else if sma50_change_pct > 1.0
    clock_position := "1 o'clock"
    clock_emoji := "↗"
    clock_color := color.new(color.green, 0)
else if sma50_change_pct > 0.4
    clock_position := "2 o'clock"
    clock_emoji := "↗"
    clock_color := color.new(color.green, 20)
else if sma50_change_pct > 0.1
    clock_position := "2-3 o'clock"
    clock_emoji := "→↗"
    clock_color := color.new(color.green, 40)
else if sma50_change_pct > -0.1
    clock_position := "3 o'clock"
    clock_emoji := "→"
    clock_color := color.new(color.gray, 0)
else if sma50_change_pct > -0.4
    clock_position := "3-4 o'clock"
    clock_emoji := "→↘"
    clock_color := color.new(color.red, 40)
else if sma50_change_pct > -1.0
    clock_position := "4 o'clock"
    clock_emoji := "↘"
    clock_color := color.new(color.red, 20)
else if sma50_change_pct > -2.0
    clock_position := "5 o'clock"
    clock_emoji := "↘"
    clock_color := color.new(color.red, 0)
else
    clock_position := "6 o'clock"
    clock_emoji := "⬇"
    clock_color := color.new(color.red, 0)

htf_ema20_weekly = i_show_htf_ema_levels ? request.security(syminfo.tickerid, "W", ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off) : na
htf_ema20_monthly = i_show_htf_ema_levels ? request.security(syminfo.tickerid, "M", ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off) : na
htf_ema20_quarterly = i_show_htf_ema_levels ? request.security(syminfo.tickerid, "3M", ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off) : na
htf_ema20_halfyear = i_show_htf_ema_levels ? request.security(syminfo.tickerid, "6M", ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off) : na
htf_ema20_yearly = i_show_htf_ema_levels ? request.security(syminfo.tickerid, "12M", ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off) : na

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD 2 — HTF SMA 50 FOR TREND DETECTION
// Compare inside request.security for consistent results. Ranging threshold treats flat SMA as Ranging.
// ══════════════════════════════════════════════════════════════════════════════

_dash2_ranging_mult = 1.0 + i_dash2_ranging_pct / 100.0

[dash2_d_is_up, dash2_d_is_down] = request.security(syminfo.tickerid, "D", [ta.sma(close, 50) > ta.sma(close, 50)[1] * _dash2_ranging_mult, ta.sma(close, 50) < ta.sma(close, 50)[1] / _dash2_ranging_mult], barmerge.gaps_off, barmerge.lookahead_off)

[dash2_w_is_up, dash2_w_is_down] = request.security(syminfo.tickerid, "W", [ta.sma(close, 50) > ta.sma(close, 50)[1] * _dash2_ranging_mult, ta.sma(close, 50) < ta.sma(close, 50)[1] / _dash2_ranging_mult], barmerge.gaps_off, barmerge.lookahead_off)

[dash2_m_is_up, dash2_m_is_down] = request.security(syminfo.tickerid, "M", [ta.sma(close, 50) > ta.sma(close, 50)[1] * _dash2_ranging_mult, ta.sma(close, 50) < ta.sma(close, 50)[1] / _dash2_ranging_mult], barmerge.gaps_off, barmerge.lookahead_off)

[dash2_q_is_up, dash2_q_is_down] = request.security(syminfo.tickerid, "3M", [ta.sma(close, 50) > ta.sma(close, 50)[1] * _dash2_ranging_mult, ta.sma(close, 50) < ta.sma(close, 50)[1] / _dash2_ranging_mult], barmerge.gaps_off, barmerge.lookahead_off)

[dash2_hy_is_up, dash2_hy_is_down] = request.security(syminfo.tickerid, "6M", [ta.sma(close, 50) > ta.sma(close, 50)[1] * _dash2_ranging_mult, ta.sma(close, 50) < ta.sma(close, 50)[1] / _dash2_ranging_mult], barmerge.gaps_off, barmerge.lookahead_off)

[dash2_y_is_up, dash2_y_is_down] = request.security(syminfo.tickerid, "12M", [ta.sma(close, 50) > ta.sma(close, 50)[1] * _dash2_ranging_mult, ta.sma(close, 50) < ta.sma(close, 50)[1] / _dash2_ranging_mult], barmerge.gaps_off, barmerge.lookahead_off)

major_golden_cross = ta.crossover(trend_ema50, trend_ema200)
major_death_cross = ta.crossunder(trend_ema50, trend_ema200)
minor_golden_cross = ta.crossover(trend_ema20, trend_ema50)
minor_death_cross = ta.crossunder(trend_ema20, trend_ema50)

body_size = math.abs(close - open)
total_range = math.max(high - low, syminfo.mintick)
body_ratio = body_size / total_range
body_high = math.max(open, close)
body_low = math.min(open, close)

is_bull = close > open
is_bear = close < open

is_strong_bull = is_bull and (body_ratio > i_legout_threshold or close > high[1])
is_strong_bear = is_bear and (body_ratio > i_legout_threshold or close < low[1])

is_base = body_ratio <= i_base_threshold

prev_body_size = math.abs(close[1] - open[1])
prev_total_range = math.max(high[1] - low[1], syminfo.mintick)
prev_body_ratio = prev_body_size / prev_total_range

[w_open, w_high, w_low, w_close] = request.security(syminfo.tickerid, "W", [open, high, low, close], lookahead = barmerge.lookahead_off)
[w_open1, w_high1, w_low1, w_close1] = request.security(syminfo.tickerid, "W", [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off)
[w_open2, w_high2, w_low2, w_close2] = request.security(syminfo.tickerid, "W", [open[2], high[2], low[2], close[2]], lookahead = barmerge.lookahead_off)
[w_open3, w_high3, w_low3, w_close3] = request.security(syminfo.tickerid, "W", [open[3], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)

[m_open, m_high, m_low, m_close] = request.security(syminfo.tickerid, "M", [open, high, low, close], lookahead = barmerge.lookahead_off)
[m_open1, m_high1, m_low1, m_close1] = request.security(syminfo.tickerid, "M", [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off)
[m_open2, m_high2, m_low2, m_close2] = request.security(syminfo.tickerid, "M", [open[2], high[2], low[2], close[2]], lookahead = barmerge.lookahead_off)
[m_open3, m_high3, m_low3, m_close3] = request.security(syminfo.tickerid, "M", [open[3], high[3], low[3], close[3]], lookahead = barmerge.lookahead_off)

w_bar_change = ta.change(time("W")) != 0
m_bar_change = ta.change(time("M")) != 0

